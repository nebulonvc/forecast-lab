  "raw_assessment": {
    "id": "txt-1c4066fc0c-000050396-000050436",
    "inclusion": "forecast",
    "verdict": "部分符合",
    "basis": "observed_window",
    "scope": "以东亚太平洋（EAS）占全球GDP份额作为“亚太世纪”的经济重心代理，观察1991—2024全窗：当期美元口径由22.94%升至2020年32.08%后回落至2024年28.84%；2015不变价口径由19.56%持续升至2024年32.79%。仅评估经济份额方向，不评估“亚太世纪”作为完整政治军事社会终局。",
    "reason": "两个口径在1991—2024观察窗内总体均呈上升，不变价口径持续走高，名义口径2020年后回落但仍高于1991基准，经济重心向亚太移动的趋势与受访教授判断方向一致。但“亚太世纪”是涵盖政治、军事、社会的完整终局判断，现有证据仅覆盖经济份额代理，且EAS口径不含美国与南亚，故只能判部分符合、趋势符合而终局待验证。",
    "limitation": "名义份额2020—2024回落构成反证边界；EAS区域口径与“亚太”不完全对应，且不含美国；日本长期低增长（BOJ材料）提示区域内部分化。经济份额不能代表政治军事社会层面的“亚太世纪”。",
