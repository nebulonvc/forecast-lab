  "raw_assessment": {
    "id": "txt-1c4066fc0c-000230939-000230970",
    "inclusion": "forecast",
    "verdict": "部分符合",
    "basis": "observed_window",
    "scope": "评估口径：美国离家出走/无家可归青少年队列在成年早期的教育完成、就业、住房稳定、犯罪受害/参与等群体风险，以及该群体风险是否转化为可测的宏观社会不良后果。观察时段：1991年出版后至cutoff 2026-11-09前已发表的美国队列研究（含2007、2009、2010/2011、2012、2015、2021年来源）。",
    "reason": "多项美国纵向队列显示，离家出走/无家可归青少年在学业完成、药物依赖、抑郁症状、无家可归风险等方面确有较差的成年早期结果，沿原文“预后不良”方向有持续客观证据；但同一批证据也显示多数新近无家可归青少年会较快回家或退出无家可归，群体风险并未被证明转化为宏观社会层面的不良后果。",
    "limitation": "原文“社会预后不良”是宏观社会判断，现有证据主要是群体关联而非宏观因果，且部分队列样本、年代与原文所指“大量游离青少年”的规模口径不完全对应；不能因群体风险存在就证明整个社会预后不良。",
    "evidence_ids": [
      "ev-a587fff01a0f2d533e92abe0",
      "ev-95170ad3ee3d259b8d394c0d",
      "prior-d1dbadfb9604e4624cb0",
      "prior-7be41b42ed00f422c88c",
      "ev-4889ba0ac92181cca4dd7206",
      "ev-1dff8f7f87436f8758c3cf94"
    ],
    "method": "由青少年成长环境推演社会未来人力与心理基础",
    "method_basis": "explicit",
    "observation_end": "2021-09-30",
    "future_time_text": "社会预后",
    "condition_state": "unconditional",
    "trend_aligned": true,
    "evidence_notes": [
      {
        "evidence_id": "ev-a587fff01a0f2d533e92abe0",
        "relation": "support",
        "quote": "The findings suggest that having runaway-homeless episodes have a detrimental effect on academic achievement.",
        "publication_date": "2012-08-14",
        "observation_end": null,
        "limitation": "该研究聚焦12-14岁离家出走与高中辍学，属群体关联，不能直接外推到宏观社会预后。"
      },
      {
        "evidence_id": "ev-95170ad3ee3d259b8d394c0d",
        "relation": "support",
        "quote": "runaways had higher drug dependence scores and more depressive symptoms at age 21 than non-runaways, even after taking these antecedent risk factors into account.",
        "publication_date": "2010-01-01",
        "observation_end": null,
        "limitation": "样本以白人为主，且为群体关联；未涉及犯罪受害或宏观社会指标。"
      },
      {
        "evidence_id": "prior-d1dbadfb9604e4624cb0",
        "relation": "support",
        "quote": "经过倾向分数匹配，离家出走特别多次者后续无家可归风险较高。",
        "publication_date": "2015-03-24",
        "observation_end": null,
        "limitation": "仅说明多次离家出走者风险较高，未覆盖全部游离青少年，也未证明宏观后果。"
      },
      {
        "evidence_id": "prior-7be41b42ed00f422c88c",
        "relation": "counter",
        "quote": "研究两年随访183名青少年，48%在三个月时退出无家可归并此后保持稳定，49%反复进出、4%始终无家可归；部分青少年仍有支持其复学/回家的同伴网络。",
        "publication_date": "2009-11-19",
        "observation_end": null,
        "limitation": "样本较小且为特定队列，说明相当比例可恢复，削弱“普遍预后不良”的强度。"
      },
      {
        "evidence_id": "ev-4889ba0ac92181cca4dd7206",
        "relation": "counter",
        "quote": "Most newly homeless adolescents returned home (70% U.S., 47% Australia) for significant amounts of time (39% U.S., 17% Australia more than 12 months) within two years of becoming homeless.",
        "publication_date": null,
        "observation_end": null,
        "limitation": "含澳大利亚样本，美国部分为特定城市；发表日期未知，且“回家”不等于教育就业结果良好。"
      },
      {
        "evidence_id": "ev-1dff8f7f87436f8758c3cf94",
        "relation": "boundary",
        "quote": "Three-quarters (78%) of youth went to a permanent housing situation upon exiting TLP.",
        "publication_date": "2021-09-30",
        "observation_end": null,
        "limitation": "对象是参加过渡生活项目的16-21岁无家可归青年，属有干预群体，不能代表全部游离青少年，也不能证明宏观社会预后。"
      }
    ],
    "remaining_gap": "缺少能直接检验“大量游离青少年规模是否转化为美国宏观社会不良后果”的全国性、长期、因果性证据；现有来源多为群体关联和特定队列，且部分来源发表日期未知。"
