  "assessment": {
    "id": "txt-1c4066fc0c-000031340-000031369",
    "inclusion": "forecast",
    "verdict": "部分符合",
    "basis": "observed_window",
    "scope": "以1991年后至2026-11-09前美国历史遗产保护体系是否持续运转并积累公开可用历史资料为口径；观察指标包括国家史迹名录累计入册规模、名录周报持续更新、联邦保护基金存续与拨款。",
    "reason": "原文预测美国因持续保护历史遗存而将在未来拥有可继承的历史资源。现有材料显示国家史迹名录累计入册95000余处、关联140万余资源，且2025—2026年周报持续发布，保护基金虽面临削减威胁但仍在运转，主要方向已有持续观察证据而最终终点未到，属趋势符合。",
    "limitation": "“将来美国人会有历史”是修辞性表述，无法精确操作化为单一终点；保护基金近年拨款下降、FY2026拟议取消及2025年拨款延迟显示保护体系存在压力，但尚未出现名录停止更新或资料不再公开的反证。累计存量不能直接证明1991年后逐年增量，文化认同层面的“有历史”未获直接测量。",
    "evidence_ids": [
      "prior-f6aab75697c44f53dc9e",
      "ev-d761ef1da1222b72968c5513",
