      "ev-06f751b0d341bbbcf7704783"
    ],
    "method": "经济危机推动激进政治需求",
    "method_basis": "inferred",
    "observation_end": "2026-11-09",
    "future_time_text": "",
    "condition_state": "satisfied",
    "trend_aligned": false,
    "evidence_notes": [
      {
        "evidence_id": "prior-feb6d5e84d2b6cc74719",
        "relation": "background",
        "quote": "NBER公告列出1990年7月衰退起点、1991年3月终点，2001年3月至11月、2007年12月至2009年6月、2020年2月至4月衰退。",
        "publication_date": null,
        "observation_end": null,
        "limitation": "仅证明多次衰退发生，未涉及激进组织支持变化。",
        "source_availability": {
          "status": "unknown",
          "basis": "not_established"
        }
      },
      {
        "evidence_id": "prior-51b773363118cee4bb46",
        "relation": "boundary",
        "quote": "NBER将衰退界定为广泛分布、幅度显著的经济活动下降；2020年虽短，但下降幅度和广度足够大而确认为衰退。",
        "publication_date": null,
        "observation_end": null,
        "limitation": "提供'严重衰退'的操作化定义，不涉及政治后果。",
        "source_availability": {
          "status": "unknown",
          "basis": "not_established"
        }
      },
      {
        "evidence_id": "prior-403061fc43c822c18d9b",
        "relation": "counter",
        "quote": "DSA自己的会员名册研究称长期约5000会员，2016—2020增至约5万，2021有效会员峰值不足79000，2024年10月约51000；2016、2018、2020有多重政治触发因素。",
        "publication_date": "2025-02-27",
        "observation_end": "2024-10-31",
        "limitation": "仅美国单一组织会员数，且增长期与衰退期不完全对应，不能直接证伪跨国的衰退—激进支持关系。",
        "source_availability": {
          "status": "available",
          "basis": "publication_range"
        }
      },
      {
        "evidence_id": "ev-bdd00a614441e8af540123e1",
        "relation": "counter",
        "quote": "Total DSA membership has declined since late 2021 from approximately 93,000 total members (including both dues-paying and ‘constitutional’ members who had not paid dues in the last year) to approximately 72,000 at the time of the convention.",
        "publication_date": "2023-09-25",
        "observation_end": "2023-08-06",
        "limitation": "单一组织会员数，作者归因于拜登当选等非衰退因素，不能代表西方整体激进支持。",
        "source_availability": {
          "status": "available",
          "basis": "publication_range"
        }
      },
      {
        "evidence_id": "ev-06f751b0d341bbbcf7704783",
        "relation": "counter",
        "quote": "Despite a brief increase thanks to working class radicalization over the genocide in Gaza, our membership is shrinking (a trend since 2021).",
        "publication_date": "2024-08-23",
        "observation_end": "2024-08-23",
        "limitation": "单一组织自述，会员下降趋势与衰退无同步关系，但样本有限。",
        "source_availability": {
          "status": "available",
          "basis": "publication_range"
        }
      }
    ],
    "remaining_gap": "缺少西方多国激进/社会主义政党在多次严重衰退后的选票、执政参与或会员的系统性时间序列证据，无法判断'激进分子有市场'这一主要结果的方向。"
  },
